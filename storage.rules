rules_version = '2';

// =============================================================================
// 창의재단 — Storage 보안 규칙
//
// ✅ 이 파일이 **이 프로젝트의 전체 규칙**입니다 (D-25).
//    지원사업 전용 버킷이므로 콘솔에 통째로 붙여넣으면 됩니다.
//
// 영수증 등 증빙이 올라가는 곳이다. 공개 URL은 절대 허용하지 않는다.
// 클라이언트 직접 업로드의 한계상 내용 검증은 불가하므로,
// 최소한 크기와 MIME 타입은 여기서 막는다 (§6-2 ①).
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 담당자 판별은 Custom Claims 로 한다.
    // (Storage 규칙에서는 Firestore 문서를 읽을 수 없다)
    function isStaff() {
      return isSignedIn() && request.auth.token.supportStaff == true;
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)')
          || request.resource.contentType == 'application/pdf';
    }

    function isUnderSizeLimit() {
      return request.resource.size < 20 * 1024 * 1024;  // 20MB
    }

    // 신청 서류 — 본인과 담당자만
    match /support/applications/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if isOwner(uid) && isAllowedType() && isUnderSizeLimit();
      allow delete: if isOwner(uid) || isStaff();
    }

    // 정산 증빙 — 영수증·통장사본. 특히 민감하다.
    match /support/settlements/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if isOwner(uid) && isAllowedType() && isUnderSizeLimit();
      allow delete: if isOwner(uid) || isStaff();
    }

    // 산출물 (D-76) — 지도안·발표자료·활동 사진·영상. 신청 서류보다 크고 종류가 많다.
    // 읽기는 로그인 사용자 — 공유 여부는 Firestore 규칙이 문서 단위로 판정하고,
    // 파일 주소는 문서를 읽은 사람만 얻는다.
    // 형식은 lib/firebase/outputs.ts 의 OUTPUT_FILE_TYPES 와 같은 목록 — 화면이
    // 확장자로 contentType 을 정해 올리므로 octet-stream 은 받지 않는다(실행 파일 차단).
    function isOutputType() {
      return request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic|heif)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/(msword|vnd\\.ms-powerpoint|vnd\\.ms-excel|x-hwp|x-hwpx|zip)')
          || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
          || request.resource.contentType.matches('video/(mp4|quicktime)');
    }
    match /support/outputs/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isOutputType()
        && request.resource.size < 50 * 1024 * 1024;   // 50MB — 발표 영상·pptx
      allow delete: if isOwner(uid) || isStaff();
    }

    // 공지 첨부 · 서식 자료실 — 공개 다운로드, 담당자만 업로드
    match /support/public/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
