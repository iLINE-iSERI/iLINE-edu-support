rules_version = '2';

// =============================================================================
// 창의재단 교원양성지원사업 — Firestore 보안 규칙
//
// ✅ 이 파일이 **이 프로젝트의 전체 규칙**입니다 (D-25).
//    지원사업 전용 Firebase 프로젝트를 따로 쓰므로 콘솔에 **통째로**
//    붙여넣으면 됩니다. iLINE 규칙과 섞을 일이 없습니다.
//
// 설계 원칙
//  · 접근 판별은 "로그인했는가"가 아니라 "support_users 문서가 있는가" (D-23)
//  · support_ 접두어는 그대로 둔다 — 프로젝트가 갈렸으니 기능상 불필요하지만,
//    한 프로젝트로 되돌려야 할 때 충돌 없이 합칠 수 있게 남겨둔다
//  · 라우트 보호가 클라이언트에만 있으므로 여기가 최종 방어선이다
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/support_users/$(request.auth.uid)).data;
    }

    // 창의재단 회원인가 — 탈퇴자는 제외
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/support_users/$(request.auth.uid))
        && memberDoc().status == 'active';
    }

    function isStaff() {
      return isMember() && memberDoc().role == 'staff';
    }

    // 테스트 계정 (D-111 · 09-26) — 비공개 공고를 보고, 거기에 신청·산출물 제출을 해 볼 수 있다.
    // 일반 회원과 똑같이 동작하고 **비공개 공고에 대한 문만** 더 열린다(담당자 권한은 없다).
    // 🔒 스스로 될 수 없다 — 가입 때 `role == 'applicant'` 로 고정되고(아래 회원 규칙),
    //    본인이 고칠 수 있는 칸에 `role` 이 없다. 담당자나 `scripts/grant-tester.mjs` 만 바꾼다.
    function isTester() {
      return isMember() && memberDoc().role == 'tester';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 지금 이 프로그램에 접수할 수 있는가.
    //
    // ⚠️ 화면(/apply/[programId])에서도 막고 있지만 그건 **브라우저 안에서만**이다.
    //    규칙에 근거가 없으면 마감된 공고에도 제출이 성사되고, 담당자는
    //    "마감했는데 왜 새 신청이 들어오지" 상태가 된다. 선정 결과에 이의가
    //    붙었을 때 "접수 기간을 지켰다"를 증명할 근거도 없어진다.
    //
    // 프로그램 문서를 한 번 읽으므로 신청 1건당 읽기가 1회 늘어난다.
    // 접수는 드문 행위라 요금에는 영향이 없다.
    function acceptingNow(programId) {
      let p = get(/databases/$(database)/documents/support_programs/$(programId)).data;
      // 테스트 계정은 비공개 공고에도 낼 수 있다(D-111). 접수 기간은 똑같이 지킨다
      return (p.published == true || isTester())
        && (!('opensAt' in p) || request.time >= p.opensAt)
        && (!('closesAt' in p) || request.time <= p.closesAt);
    }

    // ── 회원 ─────────────────────────────────────────────────────────────
    match /support_users/{uid} {
      // 본인 또는 담당자만 조회
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();

      // 최초 등록: 본인만, 그리고 role은 반드시 applicant로 고정한다.
      // (staff 권한을 스스로 부여하지 못하도록)
      allow create: if isOwner(uid)
        && request.resource.data.role == 'applicant'
        && request.resource.data.status == 'active'
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.consents is list;

      // ── 수정 ────────────────────────────────────────────────────────
      //
      // ⚠️ 예전에는 `role` 이 그대로인지만 확인했다. 그러면 본인이
      //    **`consents`(동의 이력) · `email` · `status` · `createdAt` 을
      //    마음대로 고칠 수 있었다.** 특히 동의 이력은 "언제 무슨 문구에
      //    동의했는가"가 전부인데, 본인이 덮어쓸 수 있으면 기록으로서
      //    아무 값이 없어진다. (09-09 회원정보 수정 화면을 만들며 발견)
      //
      // 그래서 D-48(본인 취소)에서 쓴 방식대로 **바꿀 수 있는 칸을 못 박는다.**
      // 새 칸이 생기면 여기에 이름을 추가해야 화면에서 저장된다 —
      // 번거롭지만 빠뜨렸을 때 생기는 일이 "저장이 안 된다"라서 안전하다.
      // (반대로 열어두면 빠뜨렸을 때 생기는 일이 "몰래 고쳐진다"가 된다)
      allow update: if isStaff()

        // 본인 프로필 수정 (/mypage/profile)
        || (isOwner(uid) && isMember()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'memberType', 'affiliation', 'major',
                           'studentId', 'grade', 'position', 'phone',
                           'updatedAt']))

        // 본인 탈퇴 — 삭제가 아니라 상태 변경으로만 (보존 의무)
        || (isOwner(uid) && isMember()
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt']));

      // 삭제 금지 — 탈퇴는 status 변경으로 처리한다 (보존 의무, §2-2 ②)
      allow delete: if false;
    }


    // ----- 프로그램 (공개 읽기, 담당자만 관리) -----
    match /support_programs/{id} {
      // 비공개 공고는 담당자와 테스트 계정만 (D-111)
      allow read: if resource.data.published == true || isStaff() || isTester();
      allow write: if isStaff();
    }

    // ── 신청서 ───────────────────────────────────────────────────────────
    match /support_applications/{appId} {
      allow get: if isMember() && (resource.data.uid == request.auth.uid || isStaff());

      // 본인 것만 걸러 오는 질의는 허용한다 (마이페이지 · 중복 신청 확인).
      // list 규칙은 결과로 나올 각 문서에 대해 평가되므로,
      // uid 조건이 붙지 않은 질의는 여기서 통째로 거부된다.
      allow list: if isStaff()
        || (isMember() && resource.data.uid == request.auth.uid);

      // D-29: 임시저장을 두지 않으므로 제출(submitted)로 바로 생성된다.
      // 'draft' 도 허용해 둔다 — 나중에 임시저장을 붙일 때 규칙을 안 고쳐도 된다.
      // 심사 상태(approved 등)를 스스로 부여하는 것은 막는다.
      //
      // 접수 기간과 공개 여부는 **여기서** 확인한다. 화면 차단은 최종 방어선이 아니다.
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted']
        && acceptingNow(request.resource.data.programId);

      // 상태 변경은 담당자만 (D-10). 본인은 아래 두 경우만 — 취소(D-48), 수정(D-73).
      // 취소된 건은 담당자도 못 바꾼다 (09-16) — 열쇠 문서가 지워져 재신청이 열린 상태라
      // 되돌리면 같은 사람의 신청서가 두 건이 된다. 기록으로만 남긴다.
      allow update: if (isStaff() && resource.data.status != 'cancelled')

        // ── 마감 전 본인 수정 (D-73 · 09-16) ─────────────────────
        // 신청서 **내용**만 고친다 — 팀 활동 중 변동(팀명·역할·계획 등)을 덮기 위해.
        //   ① 자기 신청서  ② '제출 완료' 또는 '보완 요청'  ③ 접수 기간 중
        //   ④ 바꿀 수 있는 칸을 못 박는다 — 내용(note · formData · formValues) ·
        //      새 PDF(generatedPdfPath · pdfHistory) · 흔적(editCount · lastEditedAt).
        //      상태·신청자 사본·첨부·초상권·프로그램은 여기 없으므로 못 건드린다.
        // 예전의 "draft·revision 이면 본인 update 허용" 조항은 칸 제한이 없어
        // 이 조항으로 **대체**했다(더 좁아짐). draft 는 D-29 로 쓰지 않는다.
        || (isMember()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['submitted', 'revision']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['note', 'noteLabel', 'formData', 'formValues',
                           'generatedPdfPath', 'pdfHistory',
                           'editCount', 'lastEditedAt', 'updatedAt'])
            && acceptingNow(resource.data.programId))

        // ── 본인 취소 (D-48) ─────────────────────────────────────
        // 신청자가 스스로 신청을 물릴 수 있다. 조건이 셋이다.
        //   ① 자기 신청서일 것
        //   ② '제출 완료' · '검토 중' · '보완 요청' 상태일 것
        //      — '검토 중'은 담당자가 **보고 있다는 표시일 뿐 확정이 아니다.**
        //        참여 못 하게 된 사람을 붙잡을 이유가 없고, 오히려 일찍
        //        알수록 헛심사가 준다 (09-08 재검토)
        //      — 선정·미선정은 결과가 나온 뒤라 문의로 돌린다
        //   ③ **접수 기간 중일 것** — 마감 뒤에는 재신청이 불가능해서
        //      "없던 일로 되돌리기"가 성립하지 않는다. 그때의 취소는 참여
        //      포기이고, 담당자가 알아야 하는 사건이다
        //
        // ⚠️ 바꿀 수 있는 칸을 **네 개로 못 박는다.** 이게 없으면 취소를
        //    빌미로 프로그램명·신청자 정보 같은 제출 당시 기록까지 고칠 수
        //    있다. 신청서는 제출 시점 원본이어야 한다 (D-28 / D-29).
        || (isMember()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['submitted', 'reviewing', 'revision']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelReason', 'cancelledAt', 'updatedAt'])
            && acceptingNow(resource.data.programId));

      allow delete: if false;
    }

    // ── 중복 신청 차단용 열쇠 ────────────────────────────────────────────
    //
    // 문서 ID가 `{uid}_{programId}` 로 정해져 있고, **생성만** 허용한다.
    // 이미 있으면 그 쓰기는 create 가 아니라 update 로 판정되고, update 는
    // 금지되어 있으므로 거부된다. 신청서와 한 묶음(batch)으로 쓰기 때문에
    // 여기서 막히면 **신청서도 만들어지지 않는다.**
    //
    // 화면의 중복 확인만으로는 부족하다 — 탭 두 개, 뒤로가기 후 재제출 같은
    // 경로로 통과해 시트에 두 줄·드라이브에 PDF 두 개가 쌓인다.
    //
    // ⚠️ 재신청을 열어주려면 **이 문서만 지워서는 안 된다.** 화면(/apply/[programId])이
    //    신청서 문서의 상태도 보기 때문이다. 담당자 화면의 **[신청 취소 처리]**와
    //    마이페이지의 **[신청 취소]**가 두 가지를 한 묶음으로 하므로,
    //    콘솔을 직접 만질 일은 없다.
    match /support_application_keys/{keyId} {
      allow get, list: if isStaff();
      allow create: if isMember()
        && keyId == request.auth.uid + '_' + request.resource.data.programId
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;

      // 담당자, 그리고 **본인**(D-48).
      // 본인 삭제를 열어도 남의 열쇠는 못 지운다 — 문서 안의 uid 로 판정한다.
      // 열쇠만 지우고 신청서를 안 고치는 것은 화면상 아무 효과가 없으므로
      // (findMyApplication 이 상태도 본다) 이걸로 잠금을 우회할 수는 없다.
      allow delete: if isStaff()
        || (isMember() && resource.data.uid == request.auth.uid);
    }

    // ── 정산 ─────────────────────────────────────────────────────────────
    match /support_settlements/{id} {
      allow get: if isMember() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff()
        || (isMember() && resource.data.uid == request.auth.uid);

      // 문서 ID 를 신청번호로 쓰므로(D-39) 두 번째 제출은 create 가 아니라
      // update 로 판정되고, 아래 조건에 걸려 거부된다 — 중복 제출이 구조적으로
      // 막힌다. 스스로 '승인' 상태를 부여하는 것도 여기서 차단한다.
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted'];

      // 제출 후에는 신청자가 수정할 수 없다. 반려된 건만 고쳐서 다시 낸다.
      // 승인/반려는 담당자만.
      allow update: if isStaff()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && resource.data.status in ['draft', 'rejected']
            && request.resource.data.status in ['draft', 'submitted']);

      allow delete: if false;
    }

    // ── 산출물 (D-76 · 09-17) ────────────────────────────────────────────
    //
    // 정산을 본떴다 — 신청 건에 붙고, 선정된 건에만, 담당자가 본다. 다른 점은
    // 여러 건이라는 것과 **승인 단계가 없다**는 것(제출 즉시 반영, 담당자는
    // 「추가 요청」만). 팀은 신청서 팀명으로만 묶이는데, "내가 그 팀인가"는
    // 다른 사람 신청서를 읽어야 알 수 있어 규칙으로 판정하지 않는다 —
    // 팀 목록은 서버(/api/outputs/team)가 확인해서 돌려준다.
    match /support_outputs/{id} {

      // 이 문서가 속한 프로그램
      function outputProgram() {
        return get(/databases/$(database)/documents/support_programs/$(resource.data.programId)).data;
      }

      // 참여자 공유 프로그램의 내려지지 않은 제출물인가 — 로그인 회원 누구나 본다
      function sharedNow() {
        return resource.data.hiddenByStaff == false
          && outputProgram().outputVisibility == 'members';
      }

      // 지금 이 프로그램에 산출물을 낼 수 있는가.
      // lib/firebase/outputs.ts 의 outputWindow 와 같은 계산이어야 한다:
      //   제출 기한이 있으면 그것 → 없으면 활동 기간(종료일은 그날 끝까지) → 없으면 제한 없음
      function outputWindowOpen(programId) {
        let p = get(/databases/$(database)/documents/support_programs/$(programId)).data;
        // 테스트 계정은 비공개 공고의 산출물도 낼 수 있다(D-111). 제출 기간은 똑같이 지킨다
        return (p.published == true || isTester())
          && (('outputOpensAt' in p)
                ? request.time >= p.outputOpensAt
                : (!('activityStart' in p) || request.time >= p.activityStart))
          && (('outputClosesAt' in p)
                ? request.time <= p.outputClosesAt
                : (!('activityEnd' in p) || request.time < p.activityEnd + duration.value(1, 'd')));
      }

      // 이 신청 건이 본인 것이고 선정된 건인가
      function ownsApprovedApplication(appId) {
        let a = get(/databases/$(database)/documents/support_applications/$(appId)).data;
        return a.uid == request.auth.uid && a.status == 'approved';
      }

      allow get: if isMember()
        && (resource.data.uid == request.auth.uid || isStaff() || sharedNow());

      // 질의 셋 — 본인 것(uid ==) · 담당자 · 공유 목록(programId == && hiddenByStaff == false).
      // 공유 목록 질의는 hiddenByStaff 조건을 **꼭 붙여야** 통과한다.
      allow list: if isStaff()
        || (isMember() && resource.data.uid == request.auth.uid)
        || (isMember() && sharedNow());

      // 제출 — 본인 · 선정된 자기 신청 건 · 제출 기간 안 · 처음부터 '제출됨' · 내려지지 않음
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.hiddenByStaff == false
        && ownsApprovedApplication(request.resource.data.applicationId)
        && outputWindowOpen(request.resource.data.programId);

      // 다시 제출하기 — 본인이 바꿀 수 있는 칸을 못 박는다 (D-73 방식).
      // 상태는 '제출됨'으로만 돌아간다(추가 요청을 스스로 만들 수 없다).
      // 내리기·요청 글·신청자 사본·팀명은 여기 없으므로 못 건드린다.
      allow update: if isStaff()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && request.resource.data.status == 'submitted'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'text', 'files', 'status', 'reviewNote',
                           'editCount', 'lastEditedAt', 'updatedAt'])
            && outputWindowOpen(resource.data.programId));

      // 지우지 않는다 — 내리기(hiddenByStaff)로 감춘다
      allow delete: if false;
    }

    // ── 공지 · 서식 자료실 ───────────────────────────────────────────────
    // 공지는 회원이 아니어도 읽는다 — 공고 안내는 가입 전에 보는 것이다.
    // 작성자(authorUid)는 스스로를 속일 수 없게 본인으로 고정한다.
    // 누가 올렸는지 남겨두면 잘못된 안내가 나갔을 때 확인할 수 있다.
    match /support_notices/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ── 1:1 문의 (D-93 · 09-18) ──────────────────────────────────────────
    // 비공개 — 쓴 사람과 담당자만. 회원만 쓴다(비회원은 메일·전화).
    // 회원은 만들 때 본인 uid · status 'open' · 정해진 칸만. 만든 뒤에는 「답변 봤음」 시각만
    // 바꿀 수 있다 — 글을 고치거나 답을 스스로 달 수 없다. 담당자는 답·상태만 바꾼다.
    // 시트 반영 칸(sheet*)은 서버(Admin)가 쓴다. 지우지 않는다(문의 이력).
    match /support_inquiries/{id} {
      allow get, list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isStaff());

      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 3000
        && request.resource.data.keys().hasOnly(
             ['uid', 'authorName', 'authorEmail', 'title', 'body', 'status',
              'createdAt', 'updatedAt']);

      allow update: if isSignedIn()
        && (
          // 본인 — 답변을 열어 본 시각만
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answerSeenAt']))
          ||
          // 담당자 — 답변·상태·답변 시각·답한 사람
          (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answer', 'status', 'answeredAt', 'answeredBy', 'updatedAt'])
            && request.resource.data.status in ['open', 'answered', 'closed'])
        );

      allow delete: if false;
    }

    match /support_resources/{id} {
      allow read: if true;              // 공개 (공고문·서식 배포)
      allow write: if isStaff();
    }

    // =====================================================================
    // 시설 예약 (D-52 · D-53 · D-55) — docs/4-기록/06-시설예약-설계.md §5
    //
    // 예약 1건 = 예약 문서 + 슬롯 문서(시간당 1개) + 하루 열쇠 문서를
    // 한 묶음(batch)으로 쓴다. 슬롯·열쇠는 **문서 ID 자체가 잠금**이고
    // 생성만 허용하므로, 같은 자리·시간이나 같은 날 두 번째 예약은
    // 묶음이 통째로 거부된다 — 신청서의 열쇠 문서와 같은 방식.
    // =====================================================================

    // 예약 문서
    match /support_reservations/{id} {
      allow get: if isMember() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff()
        || (isMember() && resource.data.uid == request.auth.uid);

      // 회원 예약 — 접수됨으로만 만들 수 있다. 확정은 담당자 전달 뒤.
      // 시간 규칙(정시·최대 2시간·운영 시간 안)은 여기서도 막는다.
      // 날짜 범위(4주·마감 요일)는 설정 문서를 읽어 요일 계산까지 해야 해서
      // 규칙이 너무 복잡해진다 — 화면과 lib 가 맡고, 규칙은 형식만 본다.
      // 담당자 직접 추가(D-53 ⑥)는 마감·1건·2시간·주말을 **무시**하므로 조건 없음.
      allow create: if isStaff()
        || (isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'received'
        && request.resource.data.source == 'member'
        // 회원이 잡을 수 있는 세 곳만 — 단체대관용 HY(2334)는 담당자 직접 추가로만 (D-66)
        && request.resource.data.venue in ['ML', 'ST', 'GR']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startHour is int
        && request.resource.data.hours is int
        && request.resource.data.hours >= 1 && request.resource.data.hours <= 2
        && request.resource.data.startHour >= 9
        && request.resource.data.startHour + request.resource.data.hours <= 18);

      // 본인 취소 — 바꿀 수 있는 칸 세 개로 못 박는다 (D-48 방식).
      // 확정된 것도 취소할 수 있다(D-55). 이용일 당일·지난 뒤는 화면이 막고,
      // 규칙은 날짜 계산을 하지 않는다.
      allow update: if isStaff()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['received', 'confirmed']
            && request.resource.data.status == 'cancelled'
            // 확정된 것을 취소하면 행정실에 알려야 한다 — 그 표시를 본인이
            // 거짓으로 못 넣게 이전 상태와 맞는지 본다 (설계 §5-5)
            && request.resource.data.cancelNoticePending
                 == (resource.data.status == 'confirmed')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelledAt', 'cancelNoticePending', 'updatedAt']));

      allow delete: if false;
    }

    // 자리·시간 잠금 — ID = {공간}_{자리}_{YYYYMMDD}_{HH}
    //
    // 회원이 격자를 그리려면 남의 슬롯도 읽어야 한다. 그래서 슬롯 문서에는
    // **개인정보를 넣지 않는다** — 예약 ID·공간·자리·날짜·시각뿐이다.
    // 누구 것인지는 예약 문서를 열어야 알 수 있고, 그건 본인·담당자만 읽는다.
    match /support_reservation_slots/{slotId} {
      allow read: if isMember();

      // ID 가 내용과 맞아야 한다 — 맞지 않으면 다른 자리를 잠그는 데 쓰인다.
      // 그리고 같은 묶음 안의 예약 문서가 **본인 것**이어야 한다(getAfter).
      // 이게 없으면 예약 없이 슬롯만 만들어 자리를 막아둘 수 있다.
      allow create: if isStaff()
        || (isMember()
        && slotId == request.resource.data.venue + '_' + request.resource.data.seat
             + '_' + request.resource.data.date.replace('-', '')
             + '_' + (request.resource.data.hour < 10
                        ? '0' + string(request.resource.data.hour)
                        : string(request.resource.data.hour))
        && getAfter(/databases/$(database)/documents/support_reservations/$(request.resource.data.reservationId)).data.uid
             == request.auth.uid);

      allow update: if false;

      // 담당자, 그리고 그 슬롯이 가리키는 예약의 **본인**
      allow delete: if isStaff()
        || (isMember()
            && get(/databases/$(database)/documents/support_reservations/$(resource.data.reservationId)).data.uid
                 == request.auth.uid);
    }

    // 공간마다 하루 1건 잠금 — ID = {uid}_{공간}_{YYYYMMDD}  (09-12 개정)
    match /support_reservation_days/{dayId} {
      // 본인 것만 — 문서가 없을 때도 조회가 되어야 하므로 ID 로 판정한다
      allow get: if isStaff()
        || (isMember() && dayId.split('_')[0] == request.auth.uid);
      allow list: if isStaff();
      allow create: if isMember()
        && dayId == request.auth.uid + '_' + request.resource.data.venue
             + '_' + request.resource.data.date.replace('-', '')
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isStaff()
        || (isMember() && resource.data.uid == request.auth.uid);
    }

    // 운영 설정 — 회원 화면이 날짜 범위를 계산하려면 읽어야 한다
    match /support_reservation_settings/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // 행정실 전달 기록 (2단계)
    match /support_reservation_deliveries/{id} {
      allow read, write: if isStaff();
    }
  }
}
