rules_version = '2';

// =============================================================================
// 창의재단 교원양성지원사업 — Firestore 보안 규칙
//
// ⚠️ 중요: 이 규칙은 그뤠잇의 기존 firestore.rules 파일에 **추가**해야 합니다.
//    같은 Firebase 프로젝트를 공유하므로(D-8), 이 파일로 통째로 덮어쓰면
//    그뤠잇 규칙이 사라집니다. 아래 match 블록만 복사해 넣으세요.
//
// 설계 원칙
//  · 접근 판별은 "로그인했는가"가 아니라 "support_users 문서가 있는가" (D-23)
//  · 그뤠잇 컬렉션과는 support_ 접두어로 완전 분리 (D-8)
//  · 라우트 보호가 클라이언트에만 있으므로 여기가 최종 방어선이다
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/support_users/$(request.auth.uid)).data;
    }

    // 창의재단 회원인가 — 탈퇴자는 제외
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/support_users/$(request.auth.uid))
        && memberDoc().status == 'active';
    }

    function isStaff() {
      return isMember() && memberDoc().role == 'staff';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── 회원 ─────────────────────────────────────────────────────────────
    match /support_users/{uid} {
      // 본인 또는 담당자만 조회
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();

      // 최초 등록: 본인만, 그리고 role은 반드시 applicant로 고정한다.
      // (staff 권한을 스스로 부여하지 못하도록)
      allow create: if isOwner(uid)
        && request.resource.data.role == 'applicant'
        && request.resource.data.status == 'active'
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.consents is list;

      // 수정: 본인은 프로필만, role 변경은 불가. 담당자는 role 변경 가능.
      allow update: if (isOwner(uid)
                        && request.resource.data.role == resource.data.role)
                    || isStaff();

      // 삭제 금지 — 탈퇴는 status 변경으로 처리한다 (보존 의무, §2-2 ②)
      allow delete: if false;
    }

    // ── 신청서 ───────────────────────────────────────────────────────────
    match /support_applications/{appId} {
      allow get: if isMember() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff();

      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'draft';

      // 신청자는 '작성 중'일 때만 수정 가능. 상태 변경은 담당자만. (D-10)
      allow update: if isStaff()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['draft', 'revision']
            && request.resource.data.uid == resource.data.uid);

      allow delete: if false;
    }

    // ── 정산 ─────────────────────────────────────────────────────────────
    match /support_settlements/{id} {
      allow get: if isMember() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff();

      allow create: if isMember() && request.resource.data.uid == request.auth.uid;

      // 제출 후에는 신청자가 수정할 수 없다. 승인/반려는 담당자만.
      allow update: if isStaff()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['draft', 'rejected']);

      allow delete: if false;
    }

    // ── 갤러리(산출물) ───────────────────────────────────────────────────
    match /support_outputs/{id} {
      // 승인된 것만 공개. 본인 것과 담당자는 승인 전에도 볼 수 있다. (§4-3)
      allow read: if resource.data.approved == true
        || (isSignedIn() && resource.data.submittedByUid == request.auth.uid)
        || isStaff();

      // 제출 시 스스로 승인 상태로 만들 수 없다
      allow create: if isMember()
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.approved == false;

      // 공개 승인은 담당자만
      allow update: if isStaff()
        || (isMember()
            && resource.data.submittedByUid == request.auth.uid
            && request.resource.data.approved == resource.data.approved);

      allow delete: if isStaff();
    }

    // ── 공지 · 서식 자료실 ───────────────────────────────────────────────
    match /support_notices/{id} {
      allow read: if true;              // 공개
      allow write: if isStaff();
    }

    match /support_resources/{id} {
      allow read: if true;              // 공개 (공고문·서식 배포)
      allow write: if isStaff();
    }
  }
}
