# =========================================================================
# iLINE 교원양성지원사업 — 환경변수 예시
# -------------------------------------------------------------------------
# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채우세요.
#   cp .env.local.example .env.local
#
# ⚠️ .env.local 은 절대 커밋하지 마세요. Vercel 값은 대시보드에만 넣습니다.
#    자세한 발급 절차는 docs/00-setup-guide.md 참고.
# =========================================================================

# ── Firebase 웹 SDK (브라우저 노출 O — 공개 설계값) ────────────────────
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 사이트 URL ─────────────────────────────────────────────────────────
# 인트로 허브(iLINE 레포)로 돌아가는 "홈" 버튼 목적지
NEXT_PUBLIC_INTRO_URL=https://iline.or.kr

# ── 🔒 서버 전용 (브라우저 노출 X — 절대 NEXT_PUBLIC_ 붙이지 말 것) ───
# Firebase Admin SDK — 서비스 계정 JSON에서 발췌
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 개행이 \n 으로 이스케이프된 한 줄 문자열. 따옴표로 감싸세요.
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── 🔒 Google Sheets / Drive 연동 (Phase 5) ───────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_APPLICATIONS=
GOOGLE_DRIVE_FOLDER_SETTLEMENTS=
